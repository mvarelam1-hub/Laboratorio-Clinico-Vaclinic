# PORT: puerto en el que escucha el servidor Express (server.ts). Opcional —
# si no se define, usa 3000 (el mismo valor que ya usa producción en Render).
# Útil sobre todo en desarrollo local, si el 3000 ya está ocupado por otra cosa.
# PORT="3000"

# GEMINI_API_KEY: clave de la API de Gemini, usada por el backend (server.ts,
# getGenAI()) para las funciones de IA reales del sistema (Asistente IA,
# resumen IA de informes). Sin esta variable, esas funciones quedan
# desactivadas (getGenAI() devuelve null) pero el resto del backend sigue
# funcionando con normalidad.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ==========================================================================
# Etapa 2/3 (Aseguramiento de la Calidad / Seminario) — backend real.
# NINGUNO de estos valores va hardcodeado en el código: todos se leen de
# variables de entorno (ver server/db.ts, server/auth-staff.ts, server/token.ts).
# ==========================================================================

# DATABASE_URL: cadena de conexión a PostgreSQL (Neon en producción, capa gratuita).
# Formato: postgres://usuario:password@host:5432/basededatos
DATABASE_URL="MY_POSTGRES_CONNECTION_STRING"

# PGSSLMODE: dejar SIN definir (o distinto de "disable") en producción — Neon exige TLS.
# Solo se pone en "disable" para un Postgres local de desarrollo sin TLS.
# PGSSLMODE="disable"

# PORTAL_TOKEN_SECRET: cadena larga y aleatoria (ej. `openssl rand -hex 32`)
# usada para firmar los tokens de sesión del Portal del Paciente.
PORTAL_TOKEN_SECRET="MY_LONG_RANDOM_SECRET"

# ==========================================================================
# Autenticación de PERSONAL (reemplaza Firebase Authentication/firebase-admin
# — ver server/auth-staff.ts, server/password.ts, server/session.ts,
# server/totp.ts, server/crypto-aes.ts). Ya NO se usa
# FIREBASE_ADMIN_CREDENTIALS_JSON para esto: el paquete `firebase` (cliente)
# sigue instalado solo para las notificaciones push (FCM), que son
# independientes y no se tocaron.
# ==========================================================================

# SESSION_SECRET: cadena larga y aleatoria (ej. `openssl rand -hex 32`) usada
# para firmar las sesiones de personal (server/session.ts). Cambiarla invalida
# TODAS las sesiones activas de personal (no las del Portal del Paciente,
# que usan PORTAL_TOKEN_SECRET, un secreto distinto).
SESSION_SECRET="MY_LONG_RANDOM_SECRET"

# BACKUP_ENCRYPTION_KEY: 32 bytes aleatorios codificados en HEX (64 caracteres),
# ej. `openssl rand -hex 32`. Usada por server/crypto-aes.ts (AES-256-GCM)
# para cifrar en reposo el secreto TOTP de cada usuario (usuario.totp_secret)
# antes de guardarlo — nunca se guarda en texto plano. Cambiarla deja
# ilegibles los secretos TOTP ya guardados (habría que re-enrolar a esos
# usuarios).
BACKUP_ENCRYPTION_KEY="MY_64_CHAR_HEX_KEY"

# ADMIN_INITIAL_PASSWORD: contraseña con la que scripts/migrate.mjs crea la
# cuenta de arranque (rol administrador_ti) la PRIMERA vez que arranca el
# sistema contra una base de datos sin ningún administrador_ti todavía (ver
# scripts/migrate.mjs::asegurarAdministradorDeArranque). Esa cuenta se crea
# con must_change_password = true, así que este valor solo necesita
# funcionar UNA vez — cámbialo después de usarlo y no lo reutilices.
ADMIN_INITIAL_PASSWORD="MY_ONE_TIME_BOOTSTRAP_PASSWORD"

# ADMIN_INITIAL_EMAIL: correo con el que se crea esa misma cuenta de arranque.
# Opcional — si no se define, scripts/migrate.mjs usa por defecto
# "admin.sistemas@vaclinic.local". Igual que ADMIN_INITIAL_PASSWORD, solo
# tiene efecto la primera vez (cuando todavía no existe ningún
# administrador_ti); cambiar esta variable después no actualiza el correo de
# una cuenta ya creada — eso se hace desde la app (Usuarios & Claves) o con
# un UPDATE directo en la base.
# ADMIN_INITIAL_EMAIL="admin.sistemas@vaclinic.local"

# DEV_AUTH_BYPASS_ID_USUARIO: SOLO para pruebas locales sin sesiones reales
# en la base de datos (reemplaza al antiguo DEV_AUTH_BYPASS_UID de Firebase).
# El backend lo IGNORA por completo si NODE_ENV=production, sin importar qué
# se envíe. No definir en ningún entorno de producción o demo pública.
# DEV_AUTH_BYPASS_ID_USUARIO="1"

# PUBLIC_BASE_URL: URL pública del sistema (sin barra final), p. ej.
# https://vaclinic.onrender.com. Es la base del enlace del código QR de los
# informes (/verificar/<código>). Recomendado en producción; si falta, se usa
# el Host de la petición.
# PUBLIC_BASE_URL="https://vaclinic.onrender.com"
